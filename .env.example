# Ripple local development configuration
# Copy this file to .env and adjust values as needed.
# Do not commit real secrets.

NODE_ENV=development

# PostgreSQL
# DATABASE_PORT is the host port published by Docker Compose.
# Change it if 5432 is already in use on the machine.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ripple
DATABASE_PASSWORD=ripple
DATABASE_NAME=ripple

# NestJS API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
SIMULATION_ENGINE_URL=http://localhost:8000
HEALTH_TIMEOUT_MS=2000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000

# Python simulation engine
SIMULATION_HOST=0.0.0.0
SIMULATION_PORT=8000
